{
  "compilerOptions": {
    "target": "ES2020",
    "module": "none",
    "lib": ["DOM", "DOM.Iterable", "ES2022"],
    "types": [],
    "rootDir": "web/browser",
    "outDir": "../assets/js",
    "strict": false,
    "noImplicitAny": false,
    "noEmitOnError": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true
  },
  "include": ["web/browser/**/*.ts"]
}
